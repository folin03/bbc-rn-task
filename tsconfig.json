{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest", "detox"],
    "paths": {
      "@articles": ["./src/features/articles"],
      "@articles/*": ["./src/features/articles/*"],
      "@common/*": ["./src/common/*"],
      "@theme": ["./src/theme"],
      "@api/*": ["./src/api/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
