{
  "name": "allnews",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "bundle-i": "cd ios && bundle install && cd ..",
    "pod-i": "cd ios && bundle exec pod install && cd ..",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "check-ts": "tsc --noEmit",
    "checks": "npm run lint && npm run check-format && npm run check-ts && npm run test",
    "detox-build-ios": "detox build --configuration ios.sim.debug",
    "detox-test-ios": "detox test --configuration ios.sim.debug",
    "detox-build-android-emu": "detox build --configuration android.emu.debug",
    "detox-test-android-emu": "detox test --configuration android.emu.debug"
  },
  "dependencies": {
    "@react-native-vector-icons/ionicons": "^13.1.1",
    "@shopify/flash-list": "^2.3.1",
    "@tanstack/react-query": "^5.100.10",
    "axios": "^1.16.1",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-config": "^1.6.1",
    "react-native-safe-area-context": "^5.5.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "detox": "^20.50.4",
    "eslint": "^8.19.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "overrides": {
    "fast-xml-parser": "5.7.0"
  }
}